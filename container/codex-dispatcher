#!/bin/sh

set -eu

if [ "${1:-}" = "update" ]; then
    echo "codex: run 'codex-safe update' on the host to update the shared container installation" >&2
    exit 2
fi

managed_codex="/opt/codex-safe/codex/bin/codex"
if [ -x "$managed_codex" ]; then
    exec "$managed_codex" "$@"
fi

exec /usr/local/libexec/codex-bootstrap "$@"
